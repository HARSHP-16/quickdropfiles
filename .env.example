SECRET_KEY=replace-with-a-long-random-secret
DATABASE_URL=sqlite:///data/quickdrop.db
STORAGE_BACKEND=local
UPLOAD_FOLDER=./data/uploads
MAX_FILE_SIZE_MB=100
MAX_FILES_PER_SHARE=5
MAX_TEXT_SIZE_MB=1
DEFAULT_EXPIRATION_SECONDS=3600
MAX_EXPIRATION_SECONDS=86400
RATE_LIMIT=200 per day, 50 per hour
# For Azure Blob Storage with Azure CLI credentials locally or managed identity in App Service:
# STORAGE_BACKEND=azure
AZURE_STORAGE_ACCOUNT_NAME=quickdropstoragehp
AZURE_STORAGE_CONTAINER=quickdrop-files
